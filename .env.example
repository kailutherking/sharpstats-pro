DATABASE_URL=postgres://sharpstats:sharpstats@localhost:5432/sharpstats
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=15m
PORT=4000
# Proxy hops in front of the API: 1 for Railway/Render/one Nginx, 2 for Vercel rewrite -> Railway, false if exposed directly.
TRUST_PROXY=1
CLIENT_ORIGIN=http://localhost:5173
DEMO_EMAIL=demo@sharpstats.pro
DEMO_PASSWORD=SharpStats123!
# Odds intelligence platform. The Odds API key (https://the-odds-api.com) enables every sportsbook,
# period/alternate markets, player props, no-vig EV and arbitrage. Without it, DraftKings game lines load from ESPN.
ODDS_PROVIDER=theoddsapi
ODDS_API_KEY=
ODDS_REFRESH_SECONDS=30
ODDS_BACKGROUND_REFRESH_MINUTES=30
ODDS_SHARP_BOOK=pinnacle
ODDS_MIN_CREDITS=250
# Spread The Odds API credits until the monthly reset (UTC day of month). Turn off on large plans if you prefer.
ODDS_CREDIT_PACING=true
ODDS_CREDITS_RESET_DAY=1
# Extra books, comma-separated key|Name|kind (kind: sportsbook or dfs)
ODDS_EXTRA_BOOKS=
SPORTRADAR_API_KEY=
# Stats research center (ESPN public feeds + MLB Stats API; no API key required)
STATS_REFRESH_MINUTES=15
STATS_AUTO_REFRESH=true
STATS_PROVIDER_TIMEOUT_MS=20000
# NCAA men's basketball. KenPom ratings are optional and need a paid KenPom API key.
KENPOM_API_KEY=
# Simulated betting: how often open simulated wagers are graded from final scores
SIM_GRADING_MINUTES=5

# Live game tracker and injury report (ESPN + NHL official API; no keys needed)
LIVE_PROVIDER_TIMEOUT_MS=12000
INJURY_REFRESH_MINUTES=5
