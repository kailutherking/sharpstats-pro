  featured   Boolean @default(false)
  supported  Boolean @default(true)

  @@id([sport, marketKey])
  @@map("odds_markets")
}

model OddsLine {
  lineId        String    @id @map("line_id")
  sideId        String    @map("side_id")
  gameId        String    @map("game_id") @db.VarChar(100)
  sport         String    @db.VarChar(8)
  marketKey     String    @map("market_key") @db.VarChar(60)
  bookKey       String    @map("book_key") @db.VarChar(40)
  selection     String    @db.VarChar(180)
  participant   String    @default("") @db.VarChar(180)
  point         Decimal?  @db.Decimal(10, 2)
  priceAmerican Int       @map("price_american")
  openAmerican  Int       @map("open_american")
  openPoint     Decimal?  @map("open_point") @db.Decimal(10, 2)
  openAt        DateTime  @map("open_at") @db.Timestamptz
  prevAmerican  Int?      @map("prev_american")
  prevPoint     Decimal?  @map("prev_point") @db.Decimal(10, 2)
  highAmerican  Int       @map("high_american")
  lowAmerican   Int       @map("low_american")
  highPoint     Decimal?  @map("high_point") @db.Decimal(10, 2)
  lowPoint      Decimal?  @map("low_point") @db.Decimal(10, 2)
  lastChangeAt  DateTime? @map("last_change_at") @db.Timestamptz
  firstSeenAt   DateTime  @map("first_seen_at") @db.Timestamptz
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz
  isProp        Boolean   @default(false) @map("is_prop")

  @@index([gameId])
  @@index([sideId])
  @@map("odds_lines")
}

model OddsHistory {
  id            BigInt   @id @default(autoincrement())
  lineId        String   @map("line_id")
  sideId        String   @map("side_id")
  gameId        String   @map("game_id") @db.VarChar(100)
  marketKey     String   @map("market_key") @db.VarChar(60)
  bookKey       String   @map("book_key") @db.VarChar(40)
  point         Decimal? @db.Decimal(10, 2)
  priceAmerican Int      @map("price_american")
  observedAt    DateTime @default(now()) @map("observed_at") @db.Timestamptz

  @@index([sideId, observedAt])
  @@map("odds_history")
}

