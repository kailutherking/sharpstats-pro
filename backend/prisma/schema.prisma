  potentialPayout Decimal        @map("potential_payout") @db.Decimal(14, 2)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  wagers          SimulatedBet[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("bet_slips")
}

// Open wagers are the rows with status "open" (also exposed as the open_wagers view).
model SimulatedBet {
  id                 BigInt                @id @default(autoincrement())
  slipId             BigInt                @map("slip_id")
  userId             Int                   @map("user_id")
  betId              Int                   @unique @map("bet_id")
  betType            String                @map("bet_type") @db.VarChar(16)
  sport              String                @db.VarChar(12)
  conference         String                @default("") @db.VarChar(120)
  sportsbook         String                @db.VarChar(80)
  bookKey            String                @map("book_key") @db.VarChar(40)
  description        String                @db.VarChar(400)
  stake              Decimal               @db.Decimal(12, 2)
  oddsDecimal        Decimal               @map("odds_decimal") @db.Decimal(12, 4)
  oddsAmerican       Int                   @map("odds_american")
  potentialPayout    Decimal               @map("potential_payout") @db.Decimal(14, 2)
  status             String                @default("open") @db.VarChar(8)
  payout             Decimal               @default(0) @db.Decimal(14, 2)
  profitLoss         Decimal               @default(0) @map("profit_loss") @db.Decimal(14, 2)
  units              Decimal               @default(0) @db.Decimal(10, 4)
  riskPct            Decimal               @default(0) @map("risk_pct") @db.Decimal(8, 4)
  bankrollBefore     Decimal               @default(0) @map("bankroll_before") @db.Decimal(12, 2)
  fairProbability    Decimal?              @map("fair_probability") @db.Decimal(8, 5)
  evPct              Decimal?              @map("ev_pct") @db.Decimal(9, 3)
  closingOddsDecimal Decimal?              @map("closing_odds_decimal") @db.Decimal(12, 4)
  clvPct             Decimal?              @map("clv_pct") @db.Decimal(9, 3)
  placedAt           DateTime              @default(now()) @map("placed_at") @db.Timestamptz
  settledAt          DateTime?             @map("settled_at") @db.Timestamptz
  slip               BetSlip               @relation(fields: [slipId], references: [id], onDelete: Cascade)
  legs               SimulatedBetLeg[]
  transactions       BankrollTransaction[]

  @@index([userId, placedAt(sort: Desc)])
  @@map("simulated_bets")
}

model SimulatedBetLeg {
  id              BigInt       @id @default(autoincrement())
  simBetId        BigInt       @map("sim_bet_id")
  legIndex        Int          @default(0) @map("leg_index")
  sport           String       @db.VarChar(12)
  gameId          String       @map("game_id") @db.VarChar(100)
  espnEventId     String?      @map("espn_event_id") @db.VarChar(20)
  event           String       @db.VarChar(220)
  homeTeam        String       @default("") @map("home_team") @db.VarChar(120)
  awayTeam        String       @default("") @map("away_team") @db.VarChar(120)
  commenceTime    DateTime?    @map("commence_time") @db.Timestamptz
  marketKey       String       @map("market_key") @db.VarChar(60)
  marketType      String       @map("market_type") @db.VarChar(12)
  period          String       @default("game") @db.VarChar(6)
  selection       String       @db.VarChar(180)
  participant     String       @default("") @db.VarChar(180)
  point           Decimal?     @db.Decimal(10, 2)
  label           String       @db.VarChar(300)
  conference      String       @default("") @db.VarChar(120)
  bookKey         String       @map("book_key") @db.VarChar(40)
  lineId          String?      @map("line_id")
  oddsAmerican    Int          @map("odds_american")
  oddsDecimal     Decimal      @map("odds_decimal") @db.Decimal(10, 4)
  fairProbability Decimal?     @map("fair_probability") @db.Decimal(8, 5)
  closingAmerican Int?         @map("closing_american")
  status          String       @default("open") @db.VarChar(8)
  resultValue     Decimal?     @map("result_value") @db.Decimal(10, 2)
  resultNote      String       @default("") @map("result_note") @db.VarChar(200)
  gradedAt        DateTime?    @map("graded_at") @db.Timestamptz
  wager           SimulatedBet @relation(fields: [simBetId], references: [id], onDelete: Cascade)

  @@index([simBetId])
  @@map("simulated_bet_legs")
}

model BankrollTransaction {
  id           BigInt        @id @default(autoincrement())
  userId       Int           @map("user_id")
  kind         String        @db.VarChar(12)
  amount       Decimal       @db.Decimal(14, 2)
  balanceAfter Decimal       @map("balance_after") @db.Decimal(14, 2)
  simBetId     BigInt?       @map("sim_bet_id")
  note         String        @default("") @db.VarChar(240)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  wager        SimulatedBet? @relation(fields: [simBetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("bankroll_transactions")
}
