  awayTeamId   String   @map("away_team_id") @db.VarChar(20)
  homeTeam     String   @map("home_team") @db.VarChar(120)
  awayTeam     String   @map("away_team") @db.VarChar(120)
  homeAbbr     String   @default("") @map("home_abbr") @db.VarChar(12)
  awayAbbr     String   @default("") @map("away_abbr") @db.VarChar(12)
