  @@map("injury_impact")
}

model TeamHealth {
  id                BigInt   @id @default(autoincrement())
  league            String   @db.VarChar(8)
  teamId            String   @map("team_id") @db.VarChar(20)
  teamName          String   @map("team_name") @db.VarChar(120)
  healthScore       Int      @map("health_score")
  label             String   @db.VarChar(20)
  activeInjuries    Int      @default(0) @map("active_injuries")
  outCount          Int      @default(0) @map("out_count")
  questionableCount Int      @default(0) @map("questionable_count")
  returningCount    Int      @default(0) @map("returning_count")
  suspendedCount    Int      @default(0) @map("suspended_count")
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  @@index([league, teamId, recordedAt(sort: Desc)], map: "team_health_team_idx")
  @@map("team_health")
}
