generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  username            String               @db.VarChar(40)
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @map("password_hash")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  bets                Bet[]
  bankroll            Bankroll?
  favoriteSportsbooks FavoriteSportsbook[]
  refreshTokens       RefreshToken[]
  oddsSnapshots       OddsSnapshot[]
  analytics           Analytics?
  favoriteStats       FavoriteStat[]
  oddsAlertRules      OddsAlertRule[]
  oddsFavorites       OddsFavorite[]

  @@map("users")
}

model Bet {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  sport       String    @db.VarChar(60)
  league      String    @default("") @db.VarChar(80)
  event       String    @db.VarChar(180)
  betType     String    @default("Moneyline") @map("bet_type") @db.VarChar(80)
  teamPlayer  String    @default("") @map("team_player") @db.VarChar(120)
  odds        Decimal   @db.Decimal(10, 3)
  stake       Decimal   @db.Decimal(12, 2)
  result      String    @default("pending") @db.VarChar(10)
  profitLoss  Decimal   @default(0) @map("profit_loss") @db.Decimal(12, 2)
  sportsbook  String    @db.VarChar(80)
  betDate     DateTime  @default(now()) @map("bet_date") @db.Timestamptz
  closingOdds Decimal?  @map("closing_odds") @db.Decimal(10, 3)
  marketKey   String    @default("h2h") @map("market_key") @db.VarChar(80)
  selection   String    @default("") @db.VarChar(180)
  lineValue   Decimal?  @map("line_value") @db.Decimal(10, 3)
  eventId     String?   @map("event_id") @db.VarChar(100)
  gradedAt    DateTime? @map("graded_at") @db.Timestamptz
  notes       String    @default("")
  source      String    @default("manual") @db.VarChar(12)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, betDate(sort: Desc)])
  @@index([userId, result])
  @@map("bets")
}

model Bankroll {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  startingBankroll Decimal  @default(1000) @map("starting_bankroll") @db.Decimal(12, 2)
  currentBankroll  Decimal  @default(1000) @map("current_bankroll") @db.Decimal(12, 2)
  unitSize         Decimal  @default(25) @map("unit_size") @db.Decimal(12, 2)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bankroll")
}

model Sportsbook {
  id        Int                  @id @default(autoincrement())
  name      String               @unique @db.VarChar(80)
  region    String               @default("US") @db.VarChar(30)
  bookKey   String?              @map("book_key") @db.VarChar(40)
  kind      String               @default("sportsbook") @db.VarChar(12)
  active    Boolean              @default(true)
  favorites FavoriteSportsbook[]

  @@map("sportsbooks")
}

model FavoriteSportsbook {
  userId       Int        @map("user_id")
  sportsbookId Int        @map("sportsbook_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportsbook   Sportsbook @relation(fields: [sportsbookId], references: [id], onDelete: Cascade)

  @@id([userId, sportsbookId])
  @@map("favorite_sportsbooks")
}

model RefreshToken {
  id        String    @id
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model OddsSnapshot {
  id           BigInt   @id @default(autoincrement())
  userId       Int      @map("user_id")
  eventId      String   @map("event_id") @db.VarChar(100)
  sport        String   @db.VarChar(80)
  event        String   @db.VarChar(220)
  commenceTime DateTime @map("commence_time") @db.Timestamptz
  market       String   @db.VarChar(80)
  point        Decimal? @db.Decimal(10, 3)
  outcome      String   @db.VarChar(180)
  sportsbook   String   @db.VarChar(100)
  decimalOdds  Decimal  @map("decimal_odds") @db.Decimal(10, 3)
  provider     String   @default("the-odds-api") @db.VarChar(40)
  observedAt   DateTime @default(now()) @map("observed_at") @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventId, market, outcome, sportsbook, observedAt(sort: Desc)])
  @@map("odds_snapshots")
}

model Analytics {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  roi        Decimal  @default(0) @db.Decimal(10, 4)
  winRate    Decimal  @default(0) @map("win_rate") @db.Decimal(10, 4)
  totalUnits Decimal  @default(0) @map("total_units") @db.Decimal(12, 4)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

model StatsCache {
  cacheKey  String   @id @map("cache_key") @db.VarChar(160)
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("stats_cache")
}

model FavoriteStat {
  userId     Int      @map("user_id")
  league     String   @db.VarChar(8)
  entityType String   @map("entity_type") @db.VarChar(8)
  entityId   String   @map("entity_id") @db.VarChar(40)
  name       String   @db.VarChar(120)
  teamAbbr   String   @default("") @map("team_abbr") @db.VarChar(12)
  imageUrl   String?  @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, league, entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorite_stats")
}

// Odds intelligence platform (see src/db/schema.sql for indexes and the odds_player_props view).

